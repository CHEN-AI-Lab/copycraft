# ── AI API (OpenAI-compatible) ──
# e.g. SenseTime / DeepSeek / OpenAI
OPENAI_API_KEY=***
OPENAI_BASE_URL=https://token.sensenova.cn/v1
OPENAI_MODEL=sensenova-6.7-flash-lite

# ── Payments (Creem) ──
CREEM_API_KEY=***
CREEM_PRODUCT_ID=***
CREEM_WEBHOOK_SECRET=***

# ── Supabase (Auth + Database) ──
NEXT_PUBLIC_SUPABASE_URL=https://***.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=***
SUPABASE_SERVICE_ROLE_KEY=***   # For webhook (bypasses RLS)
SUPABASE_DATABASE_URL=postgresql://***  # For Prisma migrations